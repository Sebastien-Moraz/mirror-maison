    "check:ics": "bun scripts/check.js ics",
    "check:plex": "bun scripts/check.js plex",
    "check:ping": "bun scripts/check.js ping",
    "check:xiaomi": "bun scripts/check.js xiaomi",
    "check:clouds": "bun scripts/check.js clouds"
