  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "node-ical": "^0.27.3",
    "three": "^0.186.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "trustedDependencies": ["sharp"]
